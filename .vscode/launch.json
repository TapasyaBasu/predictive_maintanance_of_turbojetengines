{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🚀 Run All (Backend + Frontend)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/RUN_ALL.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "⚙️ Start Backend API (FastAPI)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/START_BACKEND.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "📊 Start Frontend (Streamlit)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/START_FRONTEND.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}

