{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🚀 Start Full Project (Backend + Frontend)",
      "type": "shell",
      "command": "python",
      "args": ["RUN_ALL.py"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "⚙️ Start FastAPI Backend",
      "type": "shell",
      "command": "python",
      "args": ["START_BACKEND.py"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "📊 Start Streamlit Frontend",
      "type": "shell",
      "command": "python",
      "args": ["START_FRONTEND.py"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    }
  ]
}

